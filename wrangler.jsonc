{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-hub",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
